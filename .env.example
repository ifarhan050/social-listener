# Copy to service/.env. Secrets live here, never in the settings table.

# Local API port (dashboard + MCP proxy target)
SOCIAL_LISTENER_PORT=4737

# Optional: where SQLite, the browser profile and captures are stored (default: service/data)
# SOCIAL_LISTENER_DATA_DIR=

# YouTube Data API v3 key (Google Cloud Console → enable "YouTube Data API v3" → API key).
# Leave empty to disable YouTube.
# YOUTUBE_API_KEY=

# Reddit (official Data API, app-only OAuth). Leave empty to disable Reddit.
# New credentials require Reddit's approval (Responsible Builder Policy) — see README.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# Required format: <platform>:<app id>:<version> (by /u/<your reddit username>)
# REDDIT_USER_AGENT=windows:social-listener:0.1.0 (by /u/your_username)

# Phase 2 — portal sync
# PORTAL_API_KEY=

# trace | debug | info | warn | error
LOG_LEVEL=info
