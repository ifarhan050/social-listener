{
  "name": "@social-listener/service",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "connect": "tsx src/cli/connect.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/api/public','dist/api/public',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.11.2",
    "pino": "^9.5.0",
    "playwright": "^1.55.0",
    "sharp": "^0.35.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  }
}
